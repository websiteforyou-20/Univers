<header class="vn-header">
  <div class="vn-header-inner">
    <a class="vn-brand" href="/" aria-label="<%= visibleSiteName %> Startseite">
      <span class="vn-brand-logo-shell">
        <% if (visibleBrandLogo) { %>
          <img
            src="<%= visibleBrandLogo %>"
            alt=""
            onerror="this.hidden=true; this.nextElementSibling.hidden=false"
          >
          <span class="vn-brand-mark" hidden><%= visibleBrandAbbreviation %></span>
        <% } else { %>
          <span class="vn-brand-mark"><%= visibleBrandAbbreviation %></span>
        <% } %>
      </span>

      <span class="vn-brand-text">
        <strong><%= visibleSiteName %></strong>
        <small><%= visibleBrandSubtitle %></small>
      </span>
    </a>

    <button
      class="vn-mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="vnNavigation"
      aria-label="Menü öffnen"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="vn-navigation" id="vnNavigation" aria-label="Hauptnavigation">
      <details class="vn-nav-group">
        <summary>Entdecken</summary>
        <div class="vn-dropdown">
          <a href="/">Startseite</a>
          <a href="/live">Gerade live</a>
          <a href="/schedule">Streamplan</a>
          <a href="/events">Events</a>
          <a href="/news">News</a>
        </div>
      </details>

      <details class="vn-nav-group">
        <summary>Community</summary>
        <div class="vn-dropdown">
          <a href="/members">Mitglieder</a>
          <a href="/apply">Bewerben</a>
          <a href="/kontakt">Kontakt</a>
        </div>
      </details>

      <% if (currentMember) { %>
        <details class="vn-nav-group vn-member-group">
          <summary>
            <span class="vn-member-avatar">
              <% if (currentMember.avatar) { %>
                <img src="<%= currentMember.avatar %>" alt="">
              <% } else { %>
                <span><%= currentMember.name.slice(0,1).toUpperCase() %></span>
              <% } %>
            </span>
            <span>Mitgliederbereich</span>
          </summary>

          <div class="vn-dropdown">
            <a href="/member-area">Dashboard</a>
            <a href="/member-area/inbox">Postfach</a>
            <a href="/member-area/calendar">Teamkalender</a>
            <a href="/member-area/community">Pinnwand</a>
            <a href="/member-area/projects">Projekte</a>
            <a href="/member-area/media">Dateien</a>
            <a href="/member-area/polls">Abstimmungen</a>
            <form method="post" action="/member-logout">
              <button type="submit">Abmelden</button>
            </form>
          </div>
        </details>
      <% } else { %>
        <a class="vn-direct-link" href="/member-login">Anmelden</a>
      <% } %>

      <details class="vn-nav-group">
        <summary>Mehr</summary>
        <div class="vn-dropdown">
          <form action="/search" method="get" class="vn-dropdown-search">
            <label class="sr-only" for="vnSearchInput">Website durchsuchen</label>
            <input id="vnSearchInput" name="q" type="search" placeholder="Website durchsuchen">
            <button type="submit">Suchen</button>
          </form>

          <% if (currentMember) { %>
            <a href="/member-area/notifications" class="vn-notification-link">
              Benachrichtigungen
              <% if (unreadNotificationCount > 0) { %>
                <strong><%= unreadNotificationCount > 99 ? "99+" : unreadNotificationCount %></strong>
              <% } %>
            </a>
          <% } %>

          <% if (canAdmin) { %>
            <a href="/admin">Admin-Bereich</a>
          <% } %>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
(() => {
  const toggle = document.querySelector(".vn-mobile-toggle");
  const nav = document.getElementById("vnNavigation");
  const groups = [...document.querySelectorAll(".vn-nav-group")];

  if (!toggle || !nav) return;

  function closeMobileMenu() {
    toggle.setAttribute("aria-expanded", "false");
    nav.classList.remove("is-open");
    document.body.classList.remove("vn-menu-open");
  }

  function closeOtherGroups(current) {
    groups.forEach(group => {
      if (group !== current) group.open = false;
    });
  }

  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav.classList.toggle("is-open", !open);
    document.body.classList.toggle("vn-menu-open", !open);
  });

  groups.forEach(group => {
    group.addEventListener("toggle", () => {
      if (group.open) closeOtherGroups(group);
    });
  });

  document.addEventListener("click", event => {
    const insideHeader = event.target.closest(".vn-header");
    if (!insideHeader) {
      groups.forEach(group => group.open = false);
      closeMobileMenu();
    }
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") {
      groups.forEach(group => group.open = false);
      closeMobileMenu();
    }
  });

  nav.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", () => {
      groups.forEach(group => group.open = false);
      closeMobileMenu();
    });
  });
})();
</script>

<script>
(() => {
  const toggle = document.querySelector(".mobile-nav-toggle");
  const navigation = document.getElementById("primaryNavigation");

  if (!toggle || !navigation) return;

  function closeNavigation() {
    toggle.setAttribute("aria-expanded", "false");
    navigation.classList.remove("is-open");
    document.body.classList.remove("mobile-navigation-open");
  }

  toggle.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    navigation.classList.toggle("is-open", !open);
    document.body.classList.toggle("mobile-navigation-open", !open);
  });

  navigation.querySelectorAll("a").forEach(link => {
    link.addEventListener("click", closeNavigation);
  });

  document.addEventListener("keydown", event => {
    if (event.key === "Escape") closeNavigation();
  });

  document.addEventListener("click", event => {
    if (
      navigation.classList.contains("is-open") &&
      !navigation.contains(event.target) &&
      !toggle.contains(event.target)
    ) {
      closeNavigation();
    }
  });
})();
</script>

