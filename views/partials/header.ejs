
<%
  const siteBranding = data.group.branding || {
    siteName: data.group.name || "VTuber Nexus",
    subtitle: "Community Hub",
    abbreviation: "VN",
    logo: data.group.logo || ""
  };

  const visibleSiteName =
    siteBranding.siteName || data.group.name || "VTuber Nexus";

  const visibleBrandSubtitle =
    siteBranding.subtitle || "Community Hub";

  const visibleBrandAbbreviation =
    siteBranding.abbreviation || "VN";

  const visibleBrandLogo =
    siteBranding.logo || data.group.logo || "";
%>


<%
  const siteAnimations = data.group.siteAnimations || {
    enabled: true,
    type: "fade-up",
    speed: "normal",
    intensity: 100,
    trigger: "viewport",
    stagger: true,
    hoverEffects: true
  };

  const animationDurations = {
    slow: "1000ms",
    normal: "650ms",
    fast: "350ms"
  };
%>
<style>
  :root {
    --site-animation-duration: <%= animationDurations[siteAnimations.speed] || "650ms" %>;
    --site-animation-intensity: <%= Number(siteAnimations.intensity || 100) / 100 %>;
  }

  <% if (siteAnimations.enabled && siteAnimations.hoverEffects) { %>
    .panel,
    .member-card,
    .application-card,
    .contact-card,
    .dashboard-card,
    .button {
      transition:
        transform 220ms ease,
        box-shadow 220ms ease,
        border-color 220ms ease,
        opacity 220ms ease;
    }

    .panel:hover,
    .member-card:hover,
    .application-card:hover,
    .contact-card:hover,
    .dashboard-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 18px 45px rgba(0, 0, 0, .22);
    }

    .button:hover {
      transform: translateY(-1px) scale(1.01);
    }
  <% } %>

  <% if (!siteAnimations.enabled) { %>
    [data-site-animate] {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  <% } %>

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
      scroll-behavior: auto !important;
    }

    [data-site-animate] {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>


<%
  const safeUnreadNotificationCount =
    typeof unreadNotificationCount !== "undefined"
      ? Number(unreadNotificationCount || 0)
      : 0;

  const safeIsLoggedInMember =
    typeof isLoggedInMember !== "undefined"
      ? Boolean(isLoggedInMember)
      : false;

  const safeCanAdmin =
    typeof canAdmin !== "undefined"
      ? Boolean(canAdmin)
      : false;

  const safeIsFounder =
    typeof isFounder !== "undefined"
      ? Boolean(isFounder)
      : false;
%>


<%
  const siteDesign = data.group.siteDesign || {
    fontFamily: "system",
    baseFontSize: 16,
    headingScale: 100,
    textAlign: "left",
    heroAlign: "left",
    contentWidth: 1200,
    sectionSpacing: 100,
    cardRadius: 18,
    buttonRadius: 13,
    cardOpacity: 94,
    navStyle: "normal",
    showAnimations: true
  };

  const fontStacks = {
    system: 'Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
    modern: '"Trebuchet MS", Inter, ui-sans-serif, sans-serif',
    rounded: '"Arial Rounded MT Bold", "Trebuchet MS", ui-sans-serif, sans-serif',
    editorial: 'Georgia, "Times New Roman", serif',
    mono: '"Cascadia Code", "Consolas", monospace'
  };
%>
<style>
  :root {
    --site-font-family: <%- fontStacks[siteDesign.fontFamily] || fontStacks.system %>;
    --site-base-size: <%= Number(siteDesign.baseFontSize || 16) %>px;
    --site-heading-scale: <%= Number(siteDesign.headingScale || 100) / 100 %>;
    --site-content-width: <%= Number(siteDesign.contentWidth || 1200) %>px;
    --site-section-space: <%= Number(siteDesign.sectionSpacing || 100) %>px;
    --site-card-radius: <%= Number(siteDesign.cardRadius ?? 18) %>px;
    --site-button-radius: <%= Number(siteDesign.buttonRadius ?? 13) %>px;
    --site-card-opacity: <%= Number(siteDesign.cardOpacity ?? 94) / 100 %>;
    --site-text-align: <%= siteDesign.textAlign || "left" %>;
    --site-hero-align: <%= siteDesign.heroAlign || "left" %>;
  }

  html {
    font-size: var(--site-base-size);
  }

  body {
    font-family: var(--site-font-family);
  }

  body:not(.admin-page):not(.member-settings-page) {
    text-align: var(--site-text-align);
  }

  form,
  form label,
  form input,
  form select,
  form textarea {
    text-align: left;
  }

  main:not(.themed-profile-main),
  .container,
  .section,
  .page-hero,
  .dashboard-shell {
    width: min(calc(100% - 2rem), var(--site-content-width));
    margin-left: auto;
    margin-right: auto;
  }

  body.admin-page main,
  body.member-settings-page main {
    width: min(calc(100% - 2rem), 1400px);
  }

  .section {
    padding-top: var(--site-section-space);
    padding-bottom: var(--site-section-space);
  }

  h1 {
    font-size: clamp(
      <%= (3 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>rem,
      <%= (8 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>vw,
      <%= (6.5 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>rem
    );
  }

  h2 {
    font-size: clamp(
      <%= (2 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>rem,
      <%= (5 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>vw,
      <%= (3.4 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>rem
    );
  }

  h3 {
    font-size: <%= (1.2 * Number(siteDesign.headingScale || 100) / 100).toFixed(2) %>rem;
  }

  .card,
  .panel,
  .member-card,
  .contact-card,
  .application-card,
  .stat-card {
    border-radius: var(--site-card-radius);
    background-color: rgba(18, 21, 42, var(--site-card-opacity));
  }

  .button,
  button,
  input,
  select,
  textarea {
    border-radius: var(--site-button-radius);
  }

  .hero,
  .page-hero {
    text-align: var(--site-hero-align);
  }

  .hero .actions,
  .page-hero .actions {
    justify-content:
      <%= siteDesign.heroAlign === "center"
        ? "center"
        : siteDesign.heroAlign === "right"
          ? "flex-end"
          : "flex-start" %>;
  }

  <% if (siteDesign.navStyle === "compact") { %>
    .site-header,
    header nav {
      min-height: 58px;
    }

    header nav a {
      padding: .35rem .45rem;
      font-size: .88rem;
    }
  <% } else if (siteDesign.navStyle === "spacious") { %>
    .site-header,
    header nav {
      min-height: 92px;
    }

    header nav {
      gap: 1rem;
    }

    header nav a {
      padding: .75rem .85rem;
      font-size: 1.02rem;
    }
  <% } %>
</style>


<%
  const siteBg = data.group.siteBackground || {
    mode: "gradient",
    color1: "#090b16",
    color2: "#10232d",
    image: "",
    overlay: 82,
    fixed: true
  };
%>
<style>
  body {
    <% if (siteBg.mode === "solid") { %>
      background: <%= siteBg.color1 %>;
    <% } else if (siteBg.mode === "image" && siteBg.image) { %>
      background:
        linear-gradient(
          rgba(5, 7, 16, <%= Number(siteBg.overlay ?? 82) / 100 %>),
          rgba(5, 7, 16, <%= Number(siteBg.overlay ?? 82) / 100 %>)
        ),
        url("<%= siteBg.image %>") center / cover
        <%= siteBg.fixed === false ? "scroll" : "fixed" %> no-repeat;
    <% } else { %>
      background:
        radial-gradient(circle at top left, <%= siteBg.color2 %>, transparent 42%),
        radial-gradient(circle at bottom right, <%= siteBg.color1 %>, transparent 48%),
        linear-gradient(135deg, <%= siteBg.color1 %>, <%= siteBg.color2 %>);
      background-attachment: <%= siteBg.fixed === false ? "scroll" : "fixed" %>;
    <% } %>
  }
</style>



<%
