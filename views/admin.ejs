<script>
(() => {
  const fields = {
    siteName: document.getElementById("brandingSiteName"),
    subtitle: document.getElementById("brandingSubtitle"),
    abbreviation: document.getElementById("brandingAbbreviation"),
    browserTitle: document.getElementById("brandingBrowserTitle"),
    adminName: document.getElementById("brandingAdminName"),
    adminAbbreviation: document.getElementById("brandingAdminAbbreviation"),
    footerName: document.getElementById("brandingFooterName")
  };

  const output = {
    siteName: document.getElementById("brandingPreviewName"),
    subtitle: document.getElementById("brandingPreviewSubtitle"),
    abbreviation: document.getElementById("brandingPreviewAbbreviation"),
    browserTitle: document.getElementById("brandingPreviewBrowserTitle"),
    adminName: document.getElementById("brandingPreviewAdminName"),
    adminAbbreviation: document.getElementById("brandingPreviewAdminMark"),
    footerName: document.getElementById("brandingPreviewFooterName")
  };

  const logoShell = document.getElementById("brandingPreviewLogo");
  const faviconShell = document.getElementById("brandingPreviewFavicon");
  const logoInput = document.getElementById("brandingLogoInput");
  const faviconInput = document.getElementById("brandingFaviconInput");

  if (!fields.siteName || !output.siteName) return;

  function valueOr(element, fallback) {
    return String(element?.value || "").trim() || fallback;
  }

  function updateTextPreview() {
    const siteName = valueOr(fields.siteName, "Website");
    const abbreviation = valueOr(fields.abbreviation, "VN").slice(0, 5).toUpperCase();

    output.siteName.textContent = siteName;
    output.subtitle.textContent = valueOr(fields.subtitle, "Community Hub");
    output.browserTitle.textContent = valueOr(fields.browserTitle, siteName);
    output.adminName.textContent = valueOr(fields.adminName, "Admin");
    output.adminAbbreviation.textContent =
      valueOr(fields.adminAbbreviation, abbreviation).slice(0, 5).toUpperCase();
    output.footerName.textContent = valueOr(fields.footerName, siteName);

    if (output.abbreviation) {
      output.abbreviation.textContent = abbreviation;
    }

    if (faviconShell && !faviconShell.querySelector("img")) {
      faviconShell.textContent = abbreviation;
    }
  }

  Object.values(fields).forEach(field => {
    field?.addEventListener("input", updateTextPreview);
  });

  function previewImage(input, shell, fallbackText) {
    const file = input?.files?.[0];
    if (!file || !shell) return;

    const reader = new FileReader();
    reader.addEventListener("load", () => {
      shell.innerHTML = "";
      const image = document.createElement("img");
      image.src = String(reader.result || "");
      image.alt = "";
      shell.appendChild(image);
    });
    reader.readAsDataURL(file);
  }

  logoInput?.addEventListener("change", () => {
    previewImage(
      logoInput,
      logoShell,
      valueOr(fields.abbreviation, "VN")
    );
  });

  faviconInput?.addEventListener("change", () => {
    previewImage(
      faviconInput,
      faviconShell,
      valueOr(fields.abbreviation, "VN")
    );
  });

  updateTextPreview();
})();
</script>


<script>
(() => {
  const preview = document.getElementById("headerDesignPreview");
  const mode = document.getElementById("headerDesignMode");
  const color1 = document.getElementById("headerColor1");
  const color2 = document.getElementById("headerColor2");
  const accent1 = document.getElementById("headerAccent1");
  const accent2 = document.getElementById("headerAccent2");
  const overlay = document.getElementById("headerOverlay");
  const blur = document.getElementById("headerBlur");
  const shadow = document.getElementById("headerShadow");
  const imageInput = document.getElementById("headerBackgroundImage");
  const overlayValue = document.getElementById("headerOverlayValue");
  const blurValue = document.getElementById("headerBlurValue");

  if (
    !preview || !mode || !color1 || !color2 ||
    !accent1 || !accent2 || !overlay || !blur
  ) return;

  let temporaryImage = "";

  function updatePreview() {
    preview.dataset.mode = mode.value;
    preview.style.setProperty("--header-one", color1.value);
    preview.style.setProperty("--header-two", color2.value);
    preview.style.setProperty("--header-accent-one", accent1.value);
    preview.style.setProperty("--header-accent-two", accent2.value);
    preview.style.setProperty("--header-overlay", Number(overlay.value) / 100);
    preview.style.setProperty("--header-blur", `${blur.value}px`);
    preview.classList.toggle("without-shadow", !shadow?.checked);

    const currentImage = temporaryImage || preview.dataset.currentImage || "";
    if (currentImage) {
      preview.style.setProperty("--header-image", `url("${currentImage}")`);
    } else {
      preview.style.removeProperty("--header-image");
    }

    overlayValue.textContent = `${overlay.value}%`;
    blurValue.textContent = `${blur.value} px`;
  }

  [
    mode, color1, color2, accent1, accent2,
    overlay, blur, shadow
  ].forEach(element => {
    element?.addEventListener("input", updatePreview);
    element?.addEventListener("change", updatePreview);
  });

  imageInput?.addEventListener("change", () => {
    const file = imageInput.files?.[0];
    if (!file) {
      temporaryImage = "";
      updatePreview();
      return;
    }

    const reader = new FileReader();
    reader.addEventListener("load", () => {
      temporaryImage = String(reader.result || "");
      mode.value = "image";
      updatePreview();
    });
    reader.readAsDataURL(file);
  });

  updatePreview();
})();
</script>


  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const sideLinks = Array.from(
        document.querySelectorAll(".admin-side-nav a[href^='#']")
      );

      const sections = sideLinks
        .map(link => {
          const id = link.getAttribute("href").slice(1);
          const section = document.getElementById(id);
          return section ? { link, section } : null;
        })
        .filter(Boolean);

      const setActiveLink = activeLink => {
        sideLinks.forEach(link => {
          const isActive = link === activeLink;
          link.classList.toggle("is-active", isActive);
          if (isActive) {
            link.setAttribute("aria-current", "location");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      if (sections.length && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          entries => {
            const visible = entries
              .filter(entry => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

            if (!visible.length) return;

            const match = sections.find(
              item => item.section === visible[0].target
            );

            if (match) setActiveLink(match.link);
          },
          {
            rootMargin: "-18% 0px -68% 0px",
            threshold: [0, 0.1, 0.3]
          }
        );

        sections.forEach(item => observer.observe(item.section));
      }

      sideLinks.forEach(link => {
        link.addEventListener("click", () => setActiveLink(link));
      });

      const currentHash = window.location.hash;
      const initialLink = currentHash
        ? sideLinks.find(link => link.getAttribute("href") === currentHash)
        : sideLinks[0];

      if (initialLink) setActiveLink(initialLink);
    });
  </script>

