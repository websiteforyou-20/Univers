<script>
(() => {
  const preview = document.getElementById("animationPreviewCard");
  const enabled = document.getElementById("animationEnabled");
  const type = document.getElementById("animationType");
  const speed = document.getElementById("animationSpeed");
  const intensity = document.getElementById("animationIntensity");
  const intensityValue = document.getElementById("animationIntensityValue");

  if (!preview || !enabled || !type || !speed || !intensity) return;

  function duration() {
    return speed.value === "slow" ? 1000 :
      speed.value === "fast" ? 350 :
      650;
  }

  function startingTransform() {
    const strength = Number(intensity.value) / 100;
    const move = Math.round(32 * strength);

    switch (type.value) {
      case "slide-left":
        return `translateX(-${move}px)`;
      case "slide-right":
        return `translateX(${move}px)`;
      case "zoom":
        return `scale(${Math.max(.84, 1 - .09 * strength)})`;
      case "float":
        return `translateY(${Math.round(20 * strength)}px) scale(.98)`;
      case "fade":
        return "none";
      case "fade-up":
      default:
        return `translateY(${move}px)`;
    }
  }

  function playPreview() {
    intensityValue.textContent = `${intensity.value}%`;

    preview.getAnimations().forEach(animation => animation.cancel());
    preview.style.transition = "none";
    preview.style.opacity = enabled.checked ? "0" : "1";
    preview.style.transform = enabled.checked ? startingTransform() : "none";

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        preview.style.transition =
          `opacity ${duration()}ms ease, transform ${duration()}ms cubic-bezier(.2,.7,.2,1)`;
        preview.style.opacity = "1";
        preview.style.transform = "none";
      });
    });
  }

  [enabled, type, speed, intensity].forEach(element => {
    element.addEventListener("input", playPreview);
    element.addEventListener("change", playPreview);
  });

  document.getElementById("animationPreview")
    ?.addEventListener("click", playPreview);

  playPreview();
})();
</script>


<script>
(() => {
  const visibility = document.getElementById("teamEventVisibility");
  const members = document.getElementById("privateEventMembers");

  if (!visibility || !members) return;

  function updatePrivateMembers() {
    const isPrivate = visibility.value === "private";
    members.hidden = !isPrivate;
    members.querySelectorAll("input").forEach(input => {
      input.disabled = !isPrivate;
    });
  }

  visibility.addEventListener("change", updatePrivateMembers);
  updatePrivateMembers();
})();
</script>





