<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>News · <%= data.group.branding?.browserTitle || data.group.name %></title>
  <link rel="stylesheet" href="/styles.css?v=30.1.2">
  <%- include("partials/branding-head", { data }) %>
</head>
<body>
  <%- include("partials/header", { data }) %>
  <main>
    <section class="page-hero">
      <span class="eyebrow">Neuigkeiten und Ankündigungen</span>
      <h1>News</h1>
      <p>Neue Mitglieder, Projekte, Events und wichtige Meldungen aus der Gruppe.</p>
    </section>

    <section class="section">
      <% if (!news.length) { %>
        <div class="panel empty-state"><h2>Noch keine News veröffentlicht.</h2></div>
      <% } else { %>
        <div class="news-list">
          <% news.forEach(article => { %>
            <article class="panel news-list-item">
              <span class="news-date"><%= new Date(article.createdAt).toLocaleString("de-DE") %></span>
              <h2><%= article.title %></h2>
              <p><%= article.summary || article.content.slice(0, 220) %></p>
              <div class="news-meta">Von <%= article.author %></div>
              <a class="button primary" href="/news/<%= article.id %>">Artikel öffnen</a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
  <%- include("partials/footer", { data }) %>
</body>
</html>