  "private": true,
  "description": "Produktionsbereite VTuber- und Streamer-Community-Webseite mit Rollen, SQLite, Medien, Backups und Branding-Zentrale",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
